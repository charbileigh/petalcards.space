# Local port (bound to localhost by default)
PETALCARDS_PORT=3000
PETALCARDS_BIND=127.0.0.1

# Set these when using the included Caddy production setup
DOMAIN=petalcards.space
APP_ORIGIN=https://petalcards.space
TRUST_PROXY=1
COOKIE_SECURE=true

# After you create your own account, set this to false to close public sign-up.
ALLOW_REGISTRATION=true
